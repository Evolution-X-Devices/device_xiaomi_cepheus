    <string name="config_rounded_mask" translatable="false">M 118.88 0.00 C 92.62 0.73 65.04 3.19 41.99 16.95 C 25.47 26.58 13.97 43.17 8.22 61.18 C 2.11 79.38 0.60 98.71 0.00 118.88</string>
