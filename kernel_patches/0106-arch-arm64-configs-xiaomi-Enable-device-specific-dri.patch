+CONFIG_SMB1390_CHARGE_PUMP=y
+CONFIG_FRAME_WARN=4096
+
+# Proximity
+CONFIG_US_PROXIMITY=y
+
+# Sensors
+CONFIG_AKM09970=y
+
+# Simtray
+CONFIG_SIMTRAY_STATUS=y
+
+# spk-id
+CONFIG_HAS_IOMEM=y
+CONFIG_MFD_SPK_ID=y
