+CONFIG_IR_SPI=y
+CONFIG_LIRC=y
+CONFIG_RC_CORE=y
+CONFIG_RC_DECODERS=y
+CONFIG_MEDIA_RC_SUPPORT=y
+CONFIG_RC_DEVICES=y
