diff --git a/drivers/media/platform/msm/camera/cam_fd/fd_hw_mgr/cam_fd_hw_mgr.c b/drivers/media/platform/msm/camera/cam_fd/fd_hw_mgr/cam_fd_hw_mgr.c
index 2caf6d0a8..60e1c9793 100644
--- a/drivers/media/platform/msm/camera/cam_fd/fd_hw_mgr/cam_fd_hw_mgr.c
+++ b/drivers/media/platform/msm/camera/cam_fd/fd_hw_mgr/cam_fd_hw_mgr.c
@@ -880,7 +880,9 @@ static int cam_fd_mgr_util_submit_frame(void *priv, void *data)
 	trace_cam_submit_to_hw("FD", frame_req->request_id);
 
 	list_del_init(&frame_req->list);
+#ifndef CONFIG_MACH_XIAOMI_NABU
 	mutex_unlock(&hw_mgr->frame_req_mutex);
+#endif
 
 	if (hw_device->hw_intf->hw_ops.start) {
 		start_args.hw_ctx = hw_ctx;
@@ -896,20 +898,30 @@ static int cam_fd_mgr_util_submit_frame(void *priv, void *data)
 		if (rc) {
 			CAM_ERR(CAM_FD, "Failed in HW Start %d", rc);
 			mutex_unlock(&hw_device->lock);
+#ifdef CONFIG_MACH_XIAOMI_NABU
+			mutex_unlock(&hw_mgr->frame_req_mutex);
+#endif
 			goto put_req_into_free_list;
 		}
 	} else {
 		CAM_ERR(CAM_FD, "Invalid hw_ops.start");
 		mutex_unlock(&hw_device->lock);
 		rc = -EPERM;
+#ifdef CONFIG_MACH_XIAOMI_NABU
+		mutex_unlock(&hw_mgr->frame_req_mutex);
+#endif
 		goto put_req_into_free_list;
 	}
 
 	hw_device->ready_to_process = false;
 	hw_device->cur_hw_ctx = hw_ctx;
 	hw_device->req_id = frame_req->request_id;
+#ifdef CONFIG_MACH_XIAOMI_NABU
+	list_add_tail(&frame_req->list, &hw_mgr->frame_processing_list);
+#endif
 	mutex_unlock(&hw_device->lock);
 
+#ifndef CONFIG_MACH_XIAOMI_NABU
 	cam_common_util_get_curr_timestamp(&frame_req->submit_timestamp);
 	rc = cam_fd_mgr_util_put_frame_req(
 		&hw_mgr->frame_processing_list, &frame_req);
@@ -918,9 +930,15 @@ static int cam_fd_mgr_util_submit_frame(void *priv, void *data)
 			"Failed in putting frame req in processing list");
 		goto stop_unlock;
 	}
+#endif
+
+#ifdef CONFIG_MACH_XIAOMI_NABU
+	mutex_unlock(&hw_mgr->frame_req_mutex);
+#endif
 
 	return rc;
 
+#ifndef CONFIG_MACH_XIAOMI_NABU
 stop_unlock:
 	if (hw_device->hw_intf->hw_ops.stop) {
 		struct cam_fd_hw_stop_args stop_args;
@@ -933,6 +951,7 @@ static int cam_fd_mgr_util_submit_frame(void *priv, void *data)
 			sizeof(stop_args)))
 			CAM_ERR(CAM_FD, "Failed in HW Stop %d", rc);
 	}
+#endif
 put_req_into_free_list:
 	cam_fd_mgr_util_put_frame_req(&hw_mgr->frame_free_list, &frame_req);
 
diff --git a/drivers/media/platform/msm/camera/cam_icp/icp_hw/icp_hw_mgr/cam_icp_hw_mgr.c b/drivers/media/platform/msm/camera/cam_icp/icp_hw/icp_hw_mgr/cam_icp_hw_mgr.c
index 4bc666984..8af7a17a7 100644
--- a/drivers/media/platform/msm/camera/cam_icp/icp_hw/icp_hw_mgr/cam_icp_hw_mgr.c
+++ b/drivers/media/platform/msm/camera/cam_icp/icp_hw/icp_hw_mgr/cam_icp_hw_mgr.c
@@ -51,6 +51,9 @@
 #include "cam_trace.h"
 #include "cam_cpas_api.h"
 #include "cam_common_util.h"
+#ifdef CONFIG_MACH_XIAOMI_SM8150
+#include "../cam_sync/cam_sync_private.h"
+#endif
 
 #define ICP_WORKQ_TASK_CMD_TYPE 1
 #define ICP_WORKQ_TASK_MSG_TYPE 2
@@ -58,7 +61,11 @@
 #define ICP_DEV_TYPE_TO_CLK_TYPE(dev_type) \
 	((dev_type == CAM_ICP_RES_TYPE_BPS) ? ICP_CLK_HW_BPS : ICP_CLK_HW_IPE)
 
+#ifdef CONFIG_MACH_XIAOMI_SM8150
+#define ICP_DEVICE_IDLE_TIMEOUT 3000
+#else
 #define ICP_DEVICE_IDLE_TIMEOUT 400
+#endif
 
 static struct cam_icp_hw_mgr icp_hw_mgr;
 
@@ -3571,6 +3578,24 @@ static bool cam_icp_mgr_is_valid_inconfig(struct cam_packet *packet)
 			packet->num_io_configs, IPE_IO_IMAGES_MAX,
 			num_in_map_entries, CAM_MAX_IN_RES);
 
+#ifdef CONFIG_MACH_XIAOMI_SM8150
+	/*
+	 * From the input parameter side, we add the
+	 * protection to avoid the kernel mem bort which
+	 * introduced from userspace, since we have the
+	 * limit on CAM_SYNC_MAX_OBJS for icp sync_obj num.
+	 */
+	for (i = 0 ; i < packet->num_io_configs; i++) {
+		if ((io_cfg_ptr[i].direction == CAM_BUF_INPUT) &&
+			(io_cfg_ptr[i].fence >= CAM_SYNC_MAX_OBJS)) {
+				in_config_valid = false;
+				CAM_ERR(CAM_ICP,
+					"In config fence/sync_obj(%u) more than allowed(%u)",
+					io_cfg_ptr[i].fence, (CAM_SYNC_MAX_OBJS - 1));
+		}
+	}
+#endif
+
 	return in_config_valid;
 }
 
diff --git a/drivers/media/platform/msm/camera/cam_isp/cam_isp_context.c b/drivers/media/platform/msm/camera/cam_isp/cam_isp_context.c
index adf01832a..8cb5b4ff2 100644
--- a/drivers/media/platform/msm/camera/cam_isp/cam_isp_context.c
+++ b/drivers/media/platform/msm/camera/cam_isp/cam_isp_context.c
@@ -596,6 +596,10 @@ static int __cam_isp_ctx_handle_buf_done_in_activated_state(
 	struct cam_isp_ctx_req  *req_isp;
 	struct cam_context *ctx = ctx_isp->base;
 	uint64_t buf_done_req_id;
+#ifdef CONFIG_MACH_XIAOMI_SM8150
+	struct cam_ctx_request  *next_req;
+	struct cam_isp_ctx_req  *next_req_isp;
+#endif
 
 	if (list_empty(&ctx->active_req_list)) {
 		CAM_INFO(CAM_ISP, "Buf done with no active request!");
@@ -772,6 +776,33 @@ static int __cam_isp_ctx_handle_buf_done_in_activated_state(
 		ctx_isp->active_req_cnt--;
 	}
 	ctx_isp->irq_delay_detect = false;
+
+#ifdef CONFIG_MACH_XIAOMI_SM8150
+	if (ctx_isp->active_req_cnt > 0) {
+		if (list_empty(&ctx->active_req_list)) {
+			CAM_DBG(CAM_ISP, "Buf done with no active request!");
+			goto end;
+		}
+		next_req = list_first_entry(&ctx->active_req_list, struct cam_ctx_request, list);
+		CAM_DBG(CAM_REQ, "next_req:%p, active_reqcnt:%d", next_req, ctx_isp->active_req_cnt);
+
+		next_req_isp = (struct cam_isp_ctx_req *) next_req->req_priv;
+
+		CAM_DBG(CAM_REQ, "next_req_isp:bubble_detected:%d,bubble_report:%d",
+			next_req_isp->bubble_detected, next_req_isp->bubble_report);
+		if (next_req_isp->bubble_detected && next_req_isp->bubble_report) {
+			next_req_isp->num_acked = 0;
+			next_req_isp->bubble_detected = false;
+			list_del_init(&next_req->list);
+			list_add(&next_req->list, &ctx->pending_req_list);
+			atomic_set(&ctx_isp->process_bubble, 0);
+			ctx_isp->active_req_cnt--;
+			CAM_DBG(CAM_REQ,
+				"Move active request %lld to pending list(cnt = %d) [bubble recovery], ctx %u",
+				next_req->request_id, ctx_isp->active_req_cnt, ctx->ctx_id);
+		}
+	}
+#endif
 end:
 	return rc;
 }
@@ -782,6 +813,11 @@ static void __cam_isp_ctx_send_sof_boot_timestamp(
 {
 	struct cam_req_mgr_message   req_msg;
 
+#ifdef CONFIG_MACH_XIAOMI_NABU
+	if (0 == request_id)
+		return;
+#endif
+
 	req_msg.session_hdl = ctx_isp->base->session_hdl;
 	req_msg.u.frame_msg.frame_id = ctx_isp->frame_id;
 	req_msg.u.frame_msg.request_id = request_id;
@@ -3496,6 +3532,10 @@ static int __cam_isp_ctx_config_dev_in_top_state(
 	list_add_tail(&req->list, &ctx->free_req_list);
 	spin_unlock_bh(&ctx->lock);
 
+#ifdef CONFIG_MACH_XIAOMI_SM8150
+	atomic_set(&ctx_isp->process_bubble, 0);
+#endif
+
 	return rc;
 }
 
