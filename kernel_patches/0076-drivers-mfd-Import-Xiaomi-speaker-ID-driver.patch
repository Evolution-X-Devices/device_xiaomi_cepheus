diff --git a/drivers/mfd/spk-id.c b/drivers/mfd/spk-id.c
new file mode 100644
index 000000000..6860fed7f
--- /dev/null
+++ b/drivers/mfd/spk-id.c
@@ -0,0 +1,235 @@
