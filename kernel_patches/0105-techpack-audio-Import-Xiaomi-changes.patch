+void (*tas256x_sw_reset)(void *data);
+dc_detection_data_t *s_dc_detect = NULL;
+void register_tas256x_reset_func(void *fptr, dc_detection_data_t* data)
+{
+	pr_err("[TI-SmartPA:%s] ", __func__);
+	tas256x_sw_reset = fptr;
