+		if (mbhc->mbhc_cfg->enable_usbc_analog) {
+#else
 		if (mbhc->mbhc_cfg->enable_usbc_analog &&
 			mbhc->mbhc_cfg->fsa_enable) {
+#endif
 			WCD_MBHC_REG_UPDATE_BITS(WCD_MBHC_L_DET_EN, 0);
