+            __func__, module_id, port_id, param_id);
+
+    memset(&param_hdr, 0, sizeof(param_hdr));
+
+    /*  Set stream index */
+    param_hdr.module_id = module_id;
+    param_hdr.instance_id = INSTANCE_ID_0;
+    param_hdr.param_id = param_id;
