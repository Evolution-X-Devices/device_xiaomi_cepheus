+/* the maximum message length in the communication with the DSP */
+#define TFA2_MAX_PARAM_SIZE (507 * 3) /* TFA2 */
+#define TFA1_MAX_PARAM_SIZE (145 * 3) /* TFA1 */
+
+#define ROUND_DOWN(a, n) (((a) / (n)) * (n))
