+
+	dsp->ops = &wm_halo_ops;
+	dsp->work_queue = create_workqueue("cirrus_fw");
+	INIT_WORK(&dsp->boot_work, wm_adsp_boot_work);
+
+	dsp->rate_lock = rate_lock;
+	dsp->rx_rate_cache =
+		kcalloc(dsp->n_rx_channels, sizeof(u8), GFP_KERNEL);
+	dsp->tx_rate_cache =
