+	// Preset speaker calibration default value
+	dsp->cal_ambient = AMBIENT_DEFAULT;
+	dsp->cal_r = CAL_R_DEFAULT;
+	dsp->cal_status = CAL_STATUS_DEFAULT;
+	dsp->cal_checksum = CAL_R_DEFAULT + CAL_STATUS_DEFAULT;
