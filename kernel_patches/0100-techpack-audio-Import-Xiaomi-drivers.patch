+#define TFA_BQ_EQ_INDEX 0
+#define TFA_BQ_ANTI_ALIAS_INDEX 10
+#define TFA_BQ_INTEGRATOR_INDEX 13
+#define TFA98XX_MAX_EQ 10
+
+typedef struct nxpTfaEqualizer {
+	nxpTfaFilter_t filter[TFA98XX_MAX_EQ];
+} nxpTfaEqualizer_t;
