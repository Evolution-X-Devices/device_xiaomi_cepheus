+		pr_err("%s: add_codec_controls failed, err %d\n", __func__,
+		       ret);
+		return ret;
+	}
+
+	for (i = 0; i < p_tas256x->mn_channels; i++) {
+		if (p_tas256x->devs[i]->dev_ops.tas_probe)
+			ret |= (p_tas256x->devs[i]->dev_ops.tas_probe)(
+				p_tas256x, codec, i + 1);
+	}
+
+	ret = tas256x_load_init(p_tas256x);
+	if (ret < 0)
+		goto end;
