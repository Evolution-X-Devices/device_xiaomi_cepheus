+static int msm_routing_crus_load_config_get(struct snd_kcontrol *kcontrol,
+					    struct snd_ctl_elem_value *ucontrol)
+{
+	pr_debug("%s: %d\n", __func__, this_ctrl.conf_sel);
+	ucontrol->value.integer.value[0] = this_ctrl.conf_sel;
+	return 0;
+}
