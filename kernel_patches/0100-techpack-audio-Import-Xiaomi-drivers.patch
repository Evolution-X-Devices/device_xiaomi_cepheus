+	case 0:
+		dse.event = HALL_SLIDER_UP;
+		break;
+	case 1:
+		dse.event = HALL_SLIDER_DOWN;
+		break;
+	case 2:
+		dse.event = HALL_SLIDING;
+		break;
+	default:
