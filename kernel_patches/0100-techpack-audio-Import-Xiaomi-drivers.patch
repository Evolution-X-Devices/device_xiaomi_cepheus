+static void wm_adsp2v2_show_fw_status(struct wm_adsp *dsp)
+{
+	u32 scratch[2];
+	int ret;
+
+	ret = wm_adsp2_raw_read(MAXBULK, dsp->regmap,
+				dsp->base + ADSP2V2_SCRATCH0_1, scratch,
+				sizeof(scratch));
+
+	if (ret) {
+		adsp_err(dsp, "Failed to read SCRATCH regs: %d\n", ret);
