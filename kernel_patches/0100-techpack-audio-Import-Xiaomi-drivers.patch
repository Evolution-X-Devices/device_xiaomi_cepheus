+	ucontrol->value.integer.value[0] =
+		tas256x_iv_sense_enable_get(p_tas256x, channel_left);
+	p_tas256x->iv_enable = ucontrol->value.integer.value[0];
+
+	dev_info(p_tas256x->dev, "p_tas256x->iv_enable %d\n",
+		 p_tas256x->iv_enable);
