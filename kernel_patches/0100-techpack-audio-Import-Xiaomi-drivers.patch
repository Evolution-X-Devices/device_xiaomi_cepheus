+
+	error = tfa_dsp_cmd_id_write(tfa, MODULE_SPEAKERBOOST,
+				     SB_PARAM_SET_CONFIG, length,
+				     p_config_bytes);
+	if (error != Tfa98xx_Error_Ok)
