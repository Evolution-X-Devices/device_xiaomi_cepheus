+#define TFA_FAM(tfa, fieldname)                                                \
+	((tfa->tfa_family == 1) ? TFA1_BF_##fieldname : TFA2_BF_##fieldname)
+#define TFA_FAM_FW(tfa, fwname)                                                \
+	((tfa->tfa_family == 1) ? TFA1_FW_##fwname : TFA2_FW_##fwname)
