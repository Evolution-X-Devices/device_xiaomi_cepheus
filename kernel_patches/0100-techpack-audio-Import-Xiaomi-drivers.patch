+
+#include "cs35l41.h"
+
+const struct reg_default cs35l41_reg[CS35L41_MAX_CACHE_REG] = {
+	{ CS35L41_TEST_KEY_CTL, 0x00000000 },
+	{ CS35L41_USER_KEY_CTL, 0x00000000 },
