+#define CRUS_SP_IOCTL_SET_CALIB _IOWR(SPK_PROT_IOCTL_MAGIC, 222, void *)
+#define CRUS_SP_IOCTL_READ_CALIB_FROM_SLOT                                     \
+	_IOWR(SPK_PROT_IOCTL_MAGIC, 223, void *)
+#define CRUS_SP_IOCTL_WRITE_CALIB_TO_SLOT                                      \
+	_IOWR(SPK_PROT_IOCTL_MAGIC, 224, void *)
+
+#define CRUS_SP_IOCTL_GET32 _IOWR(SPK_PROT_IOCTL_MAGIC, 219, compat_uptr_t)
+#define CRUS_SP_IOCTL_SET32 _IOWR(SPK_PROT_IOCTL_MAGIC, 220, compat_uptr_t)
+#define CRUS_SP_IOCTL_GET_CALIB32                                              \
+	_IOWR(SPK_PROT_IOCTL_MAGIC, 221, compat_uptr_t)
+#define CRUS_SP_IOCTL_SET_CALIB32                                              \
