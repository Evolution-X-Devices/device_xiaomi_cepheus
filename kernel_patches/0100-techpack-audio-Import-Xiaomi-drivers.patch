+static void wm_adsp_read_fw_status(struct wm_adsp *dsp, int noffs,
+				   unsigned int *offs)
+{
+	unsigned int *scratch;
+	unsigned int i;
+	int ret;
+
+	scratch = kmalloc(sizeof(*scratch), GFP_KERNEL | GFP_DMA);
+	if (!scratch)
+		return;
+
+	for (i = 0; i < noffs; ++i) {
+		ret = regmap_read(dsp->regmap, dsp->base + offs[i], scratch);
+		if (ret) {
+			adsp_err(dsp, "Failed to read SCRATCH%u: %d\n", i, ret);
+			goto out;
+		}
+
+		offs[i] = *scratch;
+	}
+
+out:
+	kfree(scratch);
+}
