+
+	return 0;
+}
+
+static int wm_adsp_cal_checksum_get(struct snd_kcontrol *kcontrol,
+				    struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_component *component =
+		snd_soc_kcontrol_component(kcontrol);
+	struct wm_adsp *dsp = snd_soc_component_get_drvdata(component);
+
+	ucontrol->value.enumerated.item[0] = dsp->cal_checksum;
+	adsp_dbg(dsp, "get calib checksum = %d\n",
+		 ucontrol->value.enumerated.item[0]);
+
+	return 0;
+}
+
+static int wm_adsp_cal_checksum_put(struct snd_kcontrol *kcontrol,
+				    struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_component *component =
+		snd_soc_kcontrol_component(kcontrol);
+	struct wm_adsp *dsp = snd_soc_component_get_drvdata(component);
+
+	dsp->cal_checksum = ucontrol->value.enumerated.item[0];
+
+	adsp_dbg(dsp, "put calib checksum = %d\n", dsp->cal_checksum);
+
+	return 0;
+}
