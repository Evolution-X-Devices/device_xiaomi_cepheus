+			length += snprintf(buf + length, PAGE_SIZE - length,
+					   "\nmisc: %u %u %u %u %u %u %u %u\n",
+					   caldata[j - 7], caldata[j - 6],
+					   caldata[j - 5], caldata[j - 4],
+					   caldata[j - 3], caldata[j - 2],
+					   caldata[j - 1], caldata[j]);
+		}
+	} else {
+		for (i = 0; i < calibration_obj->size; ++i)
+			length += snprintf(buf + length, PAGE_SIZE - length,
