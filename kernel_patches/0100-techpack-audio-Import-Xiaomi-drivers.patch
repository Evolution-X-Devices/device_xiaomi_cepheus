+		return PTR_ERR(device);
+	}
+
+	cdev_init(&io_device.cdev, &mius_userspace_fops);
+	io_device.cdev.owner = THIS_MODULE;
+	err = cdev_add(&io_device.cdev, device_number, 1);
+	if (err) {
+		MI_PRINT_W("error %d while trying to add %s%d", err,
+			   MIUS_DEVICENAME, 0);
