+static int crus_ioctl_open(struct inode *inode, struct file *f)
+{
+	pr_debug("%s\n", __func__);
+
+	atomic_inc(&this.ioctl_count);
+	return 0;
+}
+
+static int crus_ioctl_release(struct inode *inode, struct file *f)
+{
+	atomic_dec(&this.ioctl_count);
+
+	return 0;
+}
