+	n_result = p_tas256x->read(p_tas256x, ch, TAS256X_LATCHEDINTERRUPTREG0,
+				   intr1);
+	n_result = p_tas256x->read(p_tas256x, ch, TAS256X_LATCHEDINTERRUPTREG1,
+				   intr2);
+
+	return n_result;
