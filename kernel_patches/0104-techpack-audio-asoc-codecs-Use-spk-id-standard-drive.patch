+++ b/techpack/audio/asoc/codecs/tas2557/tas2557-regmap.c
@@ -56,7 +56,7 @@
 #ifdef ENABLE_TILOAD
 #include "tiload.h"
 #endif
-#include "../spk-id.h"
+#include <linux/mfd/spk-id.h>
 
 #define LOW_TEMPERATURE_GAIN 6
 #define LOW_TEMPERATURE_COUNTER 12
