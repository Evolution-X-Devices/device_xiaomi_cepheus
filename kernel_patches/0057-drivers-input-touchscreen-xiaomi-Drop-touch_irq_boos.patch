---
 drivers/input/touchscreen/xiaomi/fts_521/fts.c      | 1 -
 drivers/input/touchscreen/xiaomi/nt36523/nt36xxx.c  | 2 --
 drivers/input/touchscreen/xiaomi/nt36672c/nt36xxx.c | 3 ---
 3 files changed, 6 deletions(-)

diff --git a/drivers/input/touchscreen/xiaomi/fts_521/fts.c b/drivers/input/touchscreen/xiaomi/fts_521/fts.c
index f00d2eb9c..965d0214e 100644
--- a/drivers/input/touchscreen/xiaomi/fts_521/fts.c
+++ b/drivers/input/touchscreen/xiaomi/fts_521/fts.c
@@ -151,7 +151,6 @@ static int fts_chip_initialization(struct fts_ts_info *info, int init_type);
 static const char *fts_get_limit(struct fts_ts_info *info);
 static irqreturn_t fts_event_handler(int irq, void *ts_info);
 extern void lpm_disable_for_input(bool on);
-extern void touch_irq_boost(void);
 
 /**
 * Release all the touches in the linux input subsystem
diff --git a/drivers/input/touchscreen/xiaomi/nt36523/nt36xxx.c b/drivers/input/touchscreen/xiaomi/nt36523/nt36xxx.c
index 39f9746cd..4e1bdb5f4 100644
--- a/drivers/input/touchscreen/xiaomi/nt36523/nt36xxx.c
+++ b/drivers/input/touchscreen/xiaomi/nt36523/nt36xxx.c
@@ -89,7 +89,6 @@ static int32_t nvt_ts_suspend(struct device *dev);
 static int32_t nvt_ts_resume(struct device *dev);
 extern int dsi_panel_lockdown_info_read(unsigned char *plockdowninfo);
 extern void dsi_panel_doubleclick_enable(bool on);
-extern void touch_irq_boost(void);
 extern void lpm_disable_for_input(bool on);
 extern int pen_charge_state_notifier_register_client(struct notifier_block *nb);
 extern int
@@ -1664,7 +1663,6 @@ static irqreturn_t nvt_ts_work_func(int irq, void *data)
 	}
 #endif
 
-	touch_irq_boost();
 	lpm_disable_for_input(true);
 
 	mutex_lock(&ts->lock);
diff --git a/drivers/input/touchscreen/xiaomi/nt36672c/nt36xxx.c b/drivers/input/touchscreen/xiaomi/nt36672c/nt36xxx.c
index bb18ef46c..93ba8565e 100644
--- a/drivers/input/touchscreen/xiaomi/nt36672c/nt36xxx.c
+++ b/drivers/input/touchscreen/xiaomi/nt36672c/nt36xxx.c
@@ -97,7 +97,6 @@ extern void dsi_panel_doubleclick_enable(bool on);
 #ifdef CONFIG_TOUCHSCREEN_XIAOMI_TOUCHFEATURE
 static int32_t nvt_check_palm(uint8_t input_id, uint8_t *data);
 #endif
-extern void touch_irq_boost(void);
 extern void lpm_disable_for_input(bool on);
 uint32_t ENG_RST_ADDR = 0x7FFF80;
 uint32_t SWRST_N8_ADDR = 0; /* read from dtsi */
@@ -1419,8 +1418,6 @@ static irqreturn_t nvt_ts_work_func(int irq, void *data)
 		pm_wakeup_event(&ts->input_dev->dev, 5000);
 	}
 #endif
-	if (ts->debug_flag == TOUCH_IRQ_BOOST)
-		touch_irq_boost();
 	mutex_lock(&ts->lock);
 	if (ts->debug_flag >= TOUCH_DISABLE_LPM)
 		lpm_disable_for_input(true);
