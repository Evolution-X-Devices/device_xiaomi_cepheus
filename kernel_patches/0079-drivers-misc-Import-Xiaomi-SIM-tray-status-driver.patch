From 332d81c9019ab860166cdc7bf20c35a6b91d1c0f Mon Sep 17 00:00:00 2001
From: Sebastiano Barezzi <barezzisebastiano@gmail.com>
Date: Wed, 22 Jun 2022 18:58:49 +0200
Subject: [PATCH 079/115] drivers: misc: Import Xiaomi SIM tray status driver

* Run clang-format on source files

Change-Id: Ie173550660a4dbaca7700c29d680fc7563fe2877
---
 drivers/misc/Kconfig   |  6 +++
 drivers/misc/Makefile  |  1 +
 drivers/misc/simtray.c | 87 ++++++++++++++++++++++++++++++++++++++++++
 3 files changed, 94 insertions(+)
 create mode 100644 drivers/misc/simtray.c

diff --git a/drivers/misc/Kconfig b/drivers/misc/Kconfig
index f3c1f626d..d54829fc5 100644
--- a/drivers/misc/Kconfig
+++ b/drivers/misc/Kconfig
@@ -613,6 +613,12 @@ config TI_DRV8846
 	  Motor Driver. The MISC peripheral holds the pwm and the
 	  driver provides an API to drive stepper motor.
 
+config SIMTRAY_STATUS
+	tristate "Xiaomi SIM tray status"
+	default n
+	help
+	  Say 'y' here to support SIM tray GPIO detection
+
 source "drivers/misc/c2port/Kconfig"
 source "drivers/misc/eeprom/Kconfig"
 source "drivers/misc/cb710/Kconfig"
diff --git a/drivers/misc/Makefile b/drivers/misc/Makefile
index c7d61c0d1..ab94fd1ad 100644
--- a/drivers/misc/Makefile
+++ b/drivers/misc/Makefile
@@ -67,6 +67,7 @@ obj-$(CONFIG_MEMORY_STATE_TIME)	+= memory_state_time.o
 obj-$(CONFIG_QPNP_MISC) 	+= qpnp-misc.o
 obj-$(CONFIG_AKM09970) 	+= akm09970.o
 obj-$(CONFIG_TI_DRV8846) += drv8846.o
+obj-$(CONFIG_SIMTRAY_STATUS) += simtray.o
 
 obj-$(CONFIG_OKL4_USER_VIRQ)	+= okl4-virq.o
 obj-$(CONFIG_OKL4_RINGBUF)	+= okl4-ringbuf.o
diff --git a/drivers/misc/simtray.c b/drivers/misc/simtray.c
new file mode 100644
index 000000000..dc941ab69
--- /dev/null
+++ b/drivers/misc/simtray.c
@@ -0,0 +1,87 @@
+#include <linux/device.h>
+#include <linux/init.h>
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/wait.h>
+#include <linux/types.h>
+#include <linux/device.h>
+#include <linux/gpio.h>
+#include <linux/of.h>
+#include <linux/of_gpio.h>
+#include <linux/of_address.h>
+#include <linux/of_device.h>
+#include <linux/platform_device.h>
+#include <linux/poll.h>
+#include <linux/slab.h>
+
+struct simtray_data {
+	struct device *dev;
+	int status_gpio;
+};
+
+static ssize_t simtray_status_show(struct device *dev,
+				   struct device_attribute *attr, char *buf)
+{
+	struct simtray_data *data = dev_get_drvdata(dev);
+
+	return scnprintf(buf, PAGE_SIZE, "%d\n",
+			 gpio_get_value(data->status_gpio));
+}
+static DEVICE_ATTR(status, 0444, simtray_status_show, NULL);
+
+static int simtray_probe(struct platform_device *pdev)
+{
+	int ret = 0;
+	struct device *dev = &pdev->dev;
+	struct device_node *np = dev->of_node;
+	struct simtray_data *data;
+
+	pr_info("%s enter\n", __func__);
+
+	data = devm_kzalloc(dev, sizeof(struct simtray_data), GFP_KERNEL);
+	if (!data)
+		return -ENOMEM;
+
+	data->status_gpio = of_get_named_gpio(np, "status-gpio", 0);
+	if (data->status_gpio < 0)
+		return -EINVAL;
+
+	ret = sysfs_create_file(&dev->kobj, &dev_attr_status.attr);
+	if (ret < 0) {
+		dev_err(dev, "Failed to create sysfs node.\n");
+		return -EINVAL;
+	}
+
+	data->dev = dev;
+	platform_set_drvdata(pdev, data);
+
+	return ret;
+}
+
+static int simtray_remove(struct platform_device *pdev)
+{
+	sysfs_remove_file(&pdev->dev.kobj, &dev_attr_status.attr);
+	return 0;
+}
+
+static const struct of_device_id simtray_of_match[] = {
+	{
+		.compatible = "xiaomi,simtray-status",
+	},
+	{},
+};
+
+static struct platform_driver simtray_status_driver = {
+	.driver = {
+		.name = "simtray-status",
+		.owner = THIS_MODULE,
+		.of_match_table = of_match_ptr(simtray_of_match),
+	},
+	.probe = simtray_probe,
+	.remove = simtray_remove,
+};
+
+module_platform_driver(simtray_status_driver);
+MODULE_AUTHOR("Tao Jun<taojun@xiaomi.com>");
+MODULE_DESCRIPTION("Xiaomi SIM tray status");
+MODULE_LICENSE("GPL");
-- 
