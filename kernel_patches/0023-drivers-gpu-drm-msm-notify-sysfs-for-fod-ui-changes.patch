From 80795373a49f1f427317819a4a8eef9bb19844a7 Mon Sep 17 00:00:00 2001
From: Demon000 <demonsingur@gmail.com>
Date: Thu, 28 May 2020 23:04:27 +0200
Subject: [PATCH 023/115] drivers: gpu: drm: msm: notify sysfs for fod ui
 changes

Change-Id: I5559a9cfe00af58847e089764452a24c39830e20
---
 drivers/gpu/drm/msm/dsi-staging/dsi_display.c | 30 +++++++++++++++++++
 drivers/gpu/drm/msm/dsi-staging/dsi_display.h |  4 +++
 drivers/gpu/drm/msm/sde/sde_connector.c       |  2 ++
 3 files changed, 36 insertions(+)

diff --git a/drivers/gpu/drm/msm/dsi-staging/dsi_display.c b/drivers/gpu/drm/msm/dsi-staging/dsi_display.c
index 3694720b9..63cdcf175 100644
--- a/drivers/gpu/drm/msm/dsi-staging/dsi_display.c
+++ b/drivers/gpu/drm/msm/dsi-staging/dsi_display.c
@@ -5046,7 +5046,29 @@ static int dsi_display_validate_split_link(struct dsi_display *display)
 	return rc;
 }
 
+static ssize_t sysfs_fod_ui_read(struct device *dev,
+	struct device_attribute *attr, char *buf)
+{
+	struct dsi_display *display;
+	bool status;
+
+	display = dev_get_drvdata(dev);
+	if (!display) {
+		pr_err("Invalid display\n");
+		return -EINVAL;
+	}
+
+	status = atomic_read(&display->fod_ui);
+
+	return snprintf(buf, PAGE_SIZE, "%d\n", status);
+}
+
+static DEVICE_ATTR(fod_ui, 0444,
+			sysfs_fod_ui_read,
+			NULL);
+
 static struct attribute *display_fs_attrs[] = {
+	&dev_attr_fod_ui.attr,
 	NULL,
 };
 static struct attribute_group display_fs_attrs_group = {
@@ -5082,6 +5104,13 @@ static int dsi_display_sysfs_deinit(struct dsi_display *display)
 
 }
 
+void dsi_display_set_fod_ui(struct dsi_display *display, bool status)
+{
+	struct device *dev = &display->pdev->dev;
+	atomic_set(&display->fod_ui, status);
+	sysfs_notify(&dev->kobj, NULL, "fod_ui");
+}
+
 /**
  * dsi_display_bind - bind dsi device with controlling device
  * @dev:        Pointer to base of platform device
@@ -5378,6 +5407,7 @@ static void dsi_display_unbind(struct device *dev,
 	}
 
 	atomic_set(&display->clkrate_change_pending, 0);
+	atomic_set(&display->fod_ui, false);
 	(void)dsi_display_sysfs_deinit(display);
 	(void)dsi_display_debugfs_deinit(display);
 
diff --git a/drivers/gpu/drm/msm/dsi-staging/dsi_display.h b/drivers/gpu/drm/msm/dsi-staging/dsi_display.h
index 694304fd7..73d8b5ac2 100644
--- a/drivers/gpu/drm/msm/dsi-staging/dsi_display.h
+++ b/drivers/gpu/drm/msm/dsi-staging/dsi_display.h
@@ -281,6 +281,8 @@ struct dsi_display {
 	struct dsi_display_boot_param *boot_disp;
 
 	u32 te_source;
+
+	atomic_t fod_ui;
 };
 
 int dsi_display_dev_probe(struct platform_device *pdev);
@@ -714,4 +716,6 @@ int dsi_display_get_panel_vfp(void *display,
 
 struct dsi_display *get_main_display(void);
 
+void dsi_display_set_fod_ui(struct dsi_display *display, bool status);
+
 #endif /* _DSI_DISPLAY_H_ */
diff --git a/drivers/gpu/drm/msm/sde/sde_connector.c b/drivers/gpu/drm/msm/sde/sde_connector.c
index 5e909b003..30a9dbd1d 100644
--- a/drivers/gpu/drm/msm/sde/sde_connector.c
+++ b/drivers/gpu/drm/msm/sde/sde_connector.c
@@ -614,6 +614,8 @@ void sde_connector_update_fod_hbm(struct drm_connector *connector)
 	mutex_lock(&display->panel->panel_lock);
 	dsi_panel_set_fod_hbm(display->panel, status);
 	mutex_unlock(&display->panel->panel_lock);
+
+	dsi_display_set_fod_ui(display, status);
 }
 
 int sde_connector_pre_kickoff(struct drm_connector *connector)
-- 
2.52.0

