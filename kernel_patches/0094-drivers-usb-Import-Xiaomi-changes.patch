Subject: [PATCH 094/115] drivers: usb: Import Xiaomi changes

Change-Id: I0c11d47f789ffe489a08c9149e94a39c3bad27f0
---
 drivers/usb/core/hub.c         |   2 +
 drivers/usb/dwc3/dwc3-msm.c    |   2 +
 drivers/usb/gadget/configfs.c  |  29 ++
 drivers/usb/pd/policy_engine.c | 842 +++++++++++++++++++++++++++++++++
 drivers/usb/pd/usbpd.h         |  56 +++
 5 files changed, 931 insertions(+)

diff --git a/drivers/usb/core/hub.c b/drivers/usb/core/hub.c
index 95a9267f4..db6d4f3c8 100644
--- a/drivers/usb/core/hub.c
+++ b/drivers/usb/core/hub.c
@@ -4825,7 +4825,9 @@ hub_port_init(struct usb_hub *hub, struct usb_device *udev, int port1,
 	/* notify HCD that we have a device connected and addressed */
 	if (hcd->driver->update_device)
 		hcd->driver->update_device(hcd, udev);
+#ifndef CONFIG_MACH_XIAOMI_SM8150 /*disable USB 2.0 Link PM to fix long time usb storage recognition issue*/
 	hub_set_initial_usb2_lpm_policy(udev);
+#endif
 fail:
 	if (retval) {
 		hub_port_disable(hub, port1, 0);
diff --git a/drivers/usb/dwc3/dwc3-msm.c b/drivers/usb/dwc3/dwc3-msm.c
index a3f9651b6..102aaf99f 100644
--- a/drivers/usb/dwc3/dwc3-msm.c
+++ b/drivers/usb/dwc3/dwc3-msm.c
@@ -4939,8 +4939,10 @@ static int dwc3_msm_gadget_vbus_draw(struct dwc3_msm *mdwc, unsigned int mA)
 		 * bail out if suspend happened with float cable
 		 * connected
 		 */
+#ifndef CONFIG_MACH_XIAOMI_SM8150 /* xiaomi charger driver need this current config float current, so remove this qcom default retuen feature. */
 		if (mA == 2)
 			return 0;
+#endif
 
 		if (!mA)
 			pval.intval = -ETIMEDOUT;
