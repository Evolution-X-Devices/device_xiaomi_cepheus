+	       MAC_Read_Value[30], MAC_Read_Value[31]);
+
+	// read the page data
+	flag = ds28el16_get_page_data_retry(PageNum, PageData);
+	if (flag != DS_TRUE) {
+		ds_err("DS28E16_cmd_readMemory error");
+		ow_reset();
+		return ERROR_R_PAGEDATA;
+	}
+
+	// insert mi_romid
+	if (anon != ANONYMOUS)
+		memcpy(MAC_Computer_Datainput, mi_romid, 8);
+	else
+		memset(MAC_Computer_Datainput, 0xff, 8);
+	msg_len += 8;
+
+	// insert Page Data
+	memcpy(&MAC_Computer_Datainput[msg_len], PageData, 16);
+	msg_len += 16;
+	memset(&MAC_Computer_Datainput[msg_len], 0x00, 16);
+	msg_len += 16;
+
+	// insert Challenge
+	memcpy(&MAC_Computer_Datainput[msg_len], Challenge, 32);
+	msg_len += 32;
+
+	// insert Bind Data Page number
+	MAC_Computer_Datainput[msg_len] = PageNum & 0x03;
+	MAC_Computer_Datainput[msg_len] = MAC_Computer_Datainput[msg_len] &
+					  0x03;
+	msg_len += 1;
+
+	// insert MANID
+	memcpy(&MAC_Computer_Datainput[msg_len], MANID, 2);
+	msg_len += 2;
+
+	// calculate the MAC
+	sha3_256_hmac(S_Secret, 32, MAC_Computer_Datainput, msg_len, CAL_MAC);
+
+	ds_dbg("host data:\n");
+	ds_dbg("%02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x",
+	       MAC_Computer_Datainput[0], MAC_Computer_Datainput[1],
+	       MAC_Computer_Datainput[2], MAC_Computer_Datainput[3],
+	       MAC_Computer_Datainput[4], MAC_Computer_Datainput[5],
+	       MAC_Computer_Datainput[6], MAC_Computer_Datainput[7],
+	       MAC_Computer_Datainput[8], MAC_Computer_Datainput[9],
+	       MAC_Computer_Datainput[10], MAC_Computer_Datainput[11],
+	       MAC_Computer_Datainput[12], MAC_Computer_Datainput[13],
+	       MAC_Computer_Datainput[14], MAC_Computer_Datainput[15],
+	       MAC_Computer_Datainput[16], MAC_Computer_Datainput[17],
+	       MAC_Computer_Datainput[18], MAC_Computer_Datainput[19],
+	       MAC_Computer_Datainput[20], MAC_Computer_Datainput[21],
+	       MAC_Computer_Datainput[22], MAC_Computer_Datainput[23],
+	       MAC_Computer_Datainput[24], MAC_Computer_Datainput[25],
+	       MAC_Computer_Datainput[26], MAC_Computer_Datainput[27],
+	       MAC_Computer_Datainput[28], MAC_Computer_Datainput[29],
+	       MAC_Computer_Datainput[30], MAC_Computer_Datainput[31],
+	       MAC_Computer_Datainput[32], MAC_Computer_Datainput[33],
+	       MAC_Computer_Datainput[34], MAC_Computer_Datainput[35],
+	       MAC_Computer_Datainput[36], MAC_Computer_Datainput[37],
+	       MAC_Computer_Datainput[38], MAC_Computer_Datainput[39],
+	       MAC_Computer_Datainput[40], MAC_Computer_Datainput[41],
+	       MAC_Computer_Datainput[42], MAC_Computer_Datainput[43],
+	       MAC_Computer_Datainput[44], MAC_Computer_Datainput[45],
+	       MAC_Computer_Datainput[46], MAC_Computer_Datainput[47],
+	       MAC_Computer_Datainput[48], MAC_Computer_Datainput[49],
+	       MAC_Computer_Datainput[50], MAC_Computer_Datainput[51],
+	       MAC_Computer_Datainput[52], MAC_Computer_Datainput[53],
+	       MAC_Computer_Datainput[54], MAC_Computer_Datainput[55],
+	       MAC_Computer_Datainput[56], MAC_Computer_Datainput[57],
+	       MAC_Computer_Datainput[58], MAC_Computer_Datainput[59],
+	       MAC_Computer_Datainput[60], MAC_Computer_Datainput[61],
+	       MAC_Computer_Datainput[62], MAC_Computer_Datainput[63],
+	       MAC_Computer_Datainput[64], MAC_Computer_Datainput[65],
+	       MAC_Computer_Datainput[66], MAC_Computer_Datainput[67],
+	       MAC_Computer_Datainput[68], MAC_Computer_Datainput[69],
+	       MAC_Computer_Datainput[70], MAC_Computer_Datainput[71],
+	       MAC_Computer_Datainput[72], MAC_Computer_Datainput[73],
+	       MAC_Computer_Datainput[74], MAC_Computer_Datainput[75],
+	       MAC_Computer_Datainput[76], MAC_Computer_Datainput[77],
+	       MAC_Computer_Datainput[78], MAC_Computer_Datainput[79]);
+
+	ds_dbg("host mac:\n");
+	ds_dbg("%02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x",
+	       CAL_MAC[0], CAL_MAC[1], CAL_MAC[2], CAL_MAC[3], CAL_MAC[4],
+	       CAL_MAC[5], CAL_MAC[6], CAL_MAC[7], CAL_MAC[8], CAL_MAC[9],
+	       CAL_MAC[10], CAL_MAC[11], CAL_MAC[12], CAL_MAC[13], CAL_MAC[14],
+	       CAL_MAC[15], CAL_MAC[16], CAL_MAC[17], CAL_MAC[18], CAL_MAC[19],
+	       CAL_MAC[20], CAL_MAC[21], CAL_MAC[22], CAL_MAC[23], CAL_MAC[24],
+	       CAL_MAC[25], CAL_MAC[26], CAL_MAC[27], CAL_MAC[28], CAL_MAC[29],
+	       CAL_MAC[30], CAL_MAC[31]);
+
+	for (i = 0; i < 32; i++) {
+		if (CAL_MAC[i] != MAC_Read_Value[i])
+			break;
+	}
+
+	if (i != 32) {
+		flag_mi_auth_result = 1;
+		mi_auth_result = ERROR_UNMATCH_MAC;
+		// for debug
+		ds_dbg("hmac is not match. result=ERROR_UNMATCH_MAC\n");
+		flag_mi_page1_data = 0;
+		return ERROR_UNMATCH_MAC;
+	} else {
+		flag_mi_auth_result = 1;
+		ds_dbg("hmac is match. result=DS_TRUE\n");
+		mi_auth_result = DS_TRUE;
+		return DS_TRUE;
+	}
+}
