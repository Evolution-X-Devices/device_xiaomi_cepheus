+static int ln8000_get_dev_role(struct i2c_client *client)
+{
+	const struct of_device_id *of_id;
+
+	of_id = of_match_device(of_match_ptr(ln8000_dt_match), &client->dev);
+	if (of_id == NULL) {
+		dev_err(&client->dev, "%s: fail to matched of_device_id\n",
+			__func__);
+		return -EINVAL;
+	}
+
+	dev_info(&client->dev, "%s: matched to %s\n", __func__,
+		 of_id->compatible);
+
+	return (int)of_id->data;
