+	u16 val;
+
+	for (i = 0; i < ARRAY_SIZE(fg_dump_regs); i++) {
+		ret = fg_read_word(bq, fg_dump_regs[i], &val);
+		if (!ret)
+			bq_dbg(PR_REGISTER, "Reg[%02X] = 0x%04X\n",
+			       fg_dump_regs[i], val);
