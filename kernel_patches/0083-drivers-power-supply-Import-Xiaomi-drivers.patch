+static int DS28E16_cmd_computeS_Secret_retry(int anon, int bdconst, int pg,
+					     unsigned char *partial)
+{
+	int i;
+
+	if (pg >= MAX_PAGENUM)
+		return DS_FALSE;
+
+	for (i = 0; i < GET_S_SECRET_RETRY; i++) {
+		if (DS28E16_cmd_computeS_Secret(anon, bdconst, pg, partial) ==
+		    DS_TRUE)
+			return DS_TRUE;
+	}
+
+	return DS_FALSE;
+}
