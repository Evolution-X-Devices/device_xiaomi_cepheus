+	ret = power_supply_get_property(
+		pdpm->cp_psy, POWER_SUPPLY_PROP_CHARGING_ENABLED, &val);
+	if (!ret)
+		pdpm->cp.charge_enabled = !!val.intval;
+
+	pr_info("pdpm->cp.charge_enabled:%d\n", pdpm->cp.charge_enabled);
+
+	return ret;
+}
