+static int __fg_read_block(struct i2c_client *client, u8 reg, u8 *buf, u8 len)
+{
+	int ret;
+	int i;
+
+	for (i = 0; i < len; i++) {
+		ret = i2c_smbus_read_byte_data(client, reg + i);
+		if (ret < 0) {
+			bq_dbg(PR_REGISTER, "i2c read reg 0x%02X faild\n",
+			       reg + i);
+			return ret;
+		}
+		buf[i] = ret;
+	}
+
+	return ret;
+}
