+	if (!di->icl_votable)
+		di->icl_votable = find_votable("DC_ICL");
+
+	if (!di->icl_votable)
+		return -EINVAL;
+
+	effective_icl_val = get_effective_result_locked(di->icl_votable);
+	pr_info("effective_icl_val: %d\n", effective_icl_val);
+	return effective_icl_val;
+}
