+static int ds28e16_remove(struct platform_device *pdev)
+{
+	struct ds28e16_data *ds28e16_data = platform_get_drvdata(pdev);
+
+	verify_psy_unregister(ds28e16_data);
+	kfree(ds28e16_data);
+	return 0;
+}
