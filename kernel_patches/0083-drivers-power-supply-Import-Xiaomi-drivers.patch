+			       mi_page1_data_slave[10], mi_page1_data_slave[11],
+			       mi_page1_data_slave[12], mi_page1_data_slave[13],
+			       mi_page1_data_slave[14],
+			       mi_page1_data_slave[15]);
+			ds_dbg("flag_mi_counter_slave is %d\n",
+			       flag_mi_counter_slave);
+			return DS_TRUE;
+		}
+	}
+
+	return DS_FALSE;
+}
