+static ssize_t ds28e16_ds_romid_status_read(struct device *dev,
+					    struct device_attribute *attr,
+					    char *buf)
+{
+	short status;
+	unsigned char RomID[10] = { 0x00 };
+	int i = 0;
+	int count = 0;
+
+	for (i = 0; i < attr_trytimes_slave; i++) {
+		status = ds28el16_Read_RomID_retry_slave(RomID);
