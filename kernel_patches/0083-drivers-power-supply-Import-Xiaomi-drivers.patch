+static int fg_set_fastcharge_mode(struct bq_fg_chip *bq, bool enable)
+{
+	u8 data[2];
+	int ret;
+
+	data[0] = enable;
+
+	bq_dbg(PR_OEM, "set fastcharge mode: enable: %d\n", enable);
+	if (enable) {
+		ret = fg_mac_write_block(bq, FG_MAC_CMD_FASTCHARGE_EN, data, 2);
+		if (ret < 0) {
+			bq_dbg(PR_OEM, "could not write fastcharge = %d\n",
+			       ret);
+			return ret;
+		}
+	} else {
+		ret = fg_mac_write_block(bq, FG_MAC_CMD_FASTCHARGE_DIS, data,
+					 2);
+		if (ret < 0) {
+			bq_dbg(PR_OEM, "could not write fastcharge = %d\n",
+			       ret);
+			return ret;
+		}
+	}
+	bq->fast_mode = enable;
+
+	return ret;
+}
