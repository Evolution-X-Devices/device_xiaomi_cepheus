+	ln8282_set_powerpath(info, forward);
+	return count;
+}
+
+static ssize_t ln8282_sysfs_hw_init(struct device *dev,
+				    struct device_attribute *attr, char *buf)
+{
+	struct ln8282_info *info = dev_get_drvdata(dev);
