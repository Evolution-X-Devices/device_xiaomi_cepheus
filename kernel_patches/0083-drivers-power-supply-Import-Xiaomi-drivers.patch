+	dev_info(di->dev, "set adapter vol to %d\n", mv);
+	di->bus.write(di, REG_FC_VOLTAGE_L, mv & 0xff);
+	di->bus.write(di, REG_FC_VOLTAGE_H, (mv >> 8) & 0xff);
+	di->bus.write(di, REG_SSCMND, VSWITCH);
