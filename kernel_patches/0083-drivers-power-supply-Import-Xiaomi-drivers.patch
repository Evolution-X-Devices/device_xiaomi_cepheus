+static int ln8000_set_ntc_alarm(struct ln8000_info *info, unsigned int cfg)
+{
+	int ret;
+
+	/* update lower bits */
+	ret = ln8000_write_reg(info, LN8000_REG_NTC_CTRL, (cfg & 0xFF));
+	if (ret < 0)
+		return ret;
+
+	/* update upper bits */
+	ret = ln8000_update_reg(info, LN8000_REG_ADC_CTRL, 0x3, (cfg >> 8));
+	return ret;
