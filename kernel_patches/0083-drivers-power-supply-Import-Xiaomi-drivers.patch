+		enable = 1;
+	else
+		enable = 0;
+	ln8282_use_ext_5V(info, enable);
+	return count;
+}
+
+static ssize_t ln8282_sysfs_store_powerpath(struct device *dev,
+					    struct device_attribute *attr,
+					    const char *buf, size_t count)
+{
+	struct ln8282_info *info = dev_get_drvdata(dev);
