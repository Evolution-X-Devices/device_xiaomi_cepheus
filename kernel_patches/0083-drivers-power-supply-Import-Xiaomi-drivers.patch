+				"%s: cannot set direction for ovp_en_gpio [%d]\n",
+				__func__, di->dt_props.rx_ovp_ctl_gpio);
+		}
+		gpio_free(di->dt_props.rx_ovp_ctl_gpio);
+	} else
+		dev_err(di->dev, "%s: unable to get ovp_en_gpio\n");
+
+	return count;
