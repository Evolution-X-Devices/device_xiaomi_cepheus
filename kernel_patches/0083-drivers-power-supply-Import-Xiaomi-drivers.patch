--- /dev/null
+++ b/drivers/power/supply/ti/Kconfig
@@ -0,0 +1,24 @@
+menu "TI Technologies, Inc. Charger support"
+
+config FUEL_GAUGE_BQ27Z561
+	tristate "TI bq27z561 battery gauge driver"
+	help
