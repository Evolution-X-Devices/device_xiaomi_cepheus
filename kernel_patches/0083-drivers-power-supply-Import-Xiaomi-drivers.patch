+	LN8282_REG_PRINT(info->regmap, LN8282_REG_HV_SC_CTRL_0, val);
+	LN8282_REG_PRINT(info->regmap, LN8282_REG_HV_SC_CTRL_1, val);
+	LN8282_REG_PRINT(info->regmap, LN8282_REG_FAULT_CTRL, val);
