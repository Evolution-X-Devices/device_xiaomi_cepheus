+		if (ds28el16_get_page_status_retry_slave(status_chip) ==
+		    DS_TRUE) {
+			MANID_slave[0] = status_chip[4];
+		} else {
+			ow_reset_slave();
+			return ERROR_R_STATUS;
+		}
+
