+static int idtp_set_effective_icl_val(struct idtp9220_device_info *di, int icl)
+{
+	int effective_icl_val = 0;
+
+	if (!di->icl_votable)
+		di->icl_votable = find_votable("DC_ICL");
+
+	if (!di->icl_votable)
+		return -EINVAL;
+
+	vote(di->icl_votable, OCP_PROTECTION_VOTER, true, icl);
