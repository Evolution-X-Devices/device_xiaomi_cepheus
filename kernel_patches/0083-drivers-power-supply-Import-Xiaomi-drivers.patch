+static int calc_delta_time(struct timeval *time_start, int *delta_time)
+{
+	struct timeval time_now;
+
+	*delta_time = 0;
+
+	do_gettimeofday(&time_now);
+	*delta_time = (time_now.tv_sec - time_start->tv_sec);
+	if (*delta_time < 0)
+		*delta_time = 0;
+
+	return 0;
+}
