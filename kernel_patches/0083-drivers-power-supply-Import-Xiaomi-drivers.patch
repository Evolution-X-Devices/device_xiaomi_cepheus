+
+	ret = power_supply_get_property(psy, POWER_SUPPLY_PROP_DP_DM_BQ, &val);
+	if (!ret)
+		cnt = val.intval;
+
+	pr_info("pulse_cnt:%d\n", cnt);
+	return cnt;
+}
