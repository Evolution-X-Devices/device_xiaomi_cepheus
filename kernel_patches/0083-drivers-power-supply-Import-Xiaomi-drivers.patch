+	ret = ln8000_update_reg(info, LN8000_REG_RECOVERY_CTRL, 0x1 << 1,
+				enable << 1);
+	if (ret < 0)
+		return ret;
+
+	/* enable BUS ADC channel */
+	if (enable) {
+		ret = ln8000_set_adc_ch(info, LN8000_ADC_CH_TSBUS, true);
+	}
+	return ret;
+}
