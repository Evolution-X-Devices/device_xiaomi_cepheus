+	?<Start, device address write>
+	?TX: Length
+	?TX: Device Disable Command
+	?TX: Parameter
+	?<Stop>
+	?<Delay>
+	?<Start, device address read>
+	?RX: Length (SMBus)
+	?RX: Result byte
+	?RX: Data
+	?<Stop>
+	*/
+
+	write_buf[write_len++] = length_byte;
+	write_buf[write_len++] = CMD_DISABLE_DEVICE;
