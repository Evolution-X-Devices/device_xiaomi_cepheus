+		0,
+	};
+
+	if (di->batt_psy) {
+		power_supply_get_property(di->batt_psy,
+					  POWER_SUPPLY_PROP_STATUS, &val);
+		batt_sts = val.intval;
+
+		power_supply_get_property(di->batt_psy,
+					  POWER_SUPPLY_PROP_CAPACITY, &val);
+		soc = val.intval;
