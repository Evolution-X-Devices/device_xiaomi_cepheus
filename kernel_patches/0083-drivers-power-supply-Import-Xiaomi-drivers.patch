+bool rx1619_check_i2c_is_ok(struct rx1619_chg *chip)
+{
+	u8 read_data = 0;
+
+	rx1619_write(chip, 0x88, 0x0000);
+	msleep(10);
+	rx1619_read(chip, &read_data, 0x0000);
+
+	if (read_data == 0x88) {
+		return true;
+	} else {
+		return false;
+	}
+}
