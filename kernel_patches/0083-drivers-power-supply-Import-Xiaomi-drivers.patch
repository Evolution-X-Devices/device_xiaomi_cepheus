+static int __fg_write_block(struct i2c_client *client, u8 reg, u8 *buf, u8 len)
+{
+	int ret;
+	int i = 0;
+
+	for (i = 0; i < len; i++) {
+		ret = i2c_smbus_write_byte_data(client, reg + i, buf[i]);
