+static int cp_limit_sw(bool enable)
+{
+	int ret;
+	struct power_supply *psy;
+	union power_supply_propval val = {
+		0,
+	};
+
+	psy = cp_get_sw_psy();
+	if (!psy)
+		return -ENODEV;
+
+	val.intval = enable;
+	ret = power_supply_set_property(
+		psy, POWER_SUPPLY_PROP_BATTERY_CHARGING_LIMITED, &val);
+
+	return ret;
+}
