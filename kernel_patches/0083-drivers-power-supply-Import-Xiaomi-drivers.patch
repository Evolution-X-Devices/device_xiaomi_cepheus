+	struct i2c_client *client = container_of(dev, struct i2c_client, dev);
+	struct idtp9220_device_info *di = i2c_get_clientdata(client);
+
+	ret = (int)simple_strtoul(buf, NULL, 10);
+	enable = !!ret;
+
+	idtp9220_set_enable_mode(di, enable);
+
+	return count;
+}
