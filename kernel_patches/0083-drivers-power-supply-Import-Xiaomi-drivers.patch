+static void idtp_oob_set_ept_work(struct work_struct *work)
+{
+	struct idtp9220_device_info *di = container_of(
+		work, struct idtp9220_device_info, oob_set_ept_work.work);
+
+	idtp9220_set_ept(di);
+
+	return;
+}
