+	if (ovp_th <= 6500000) {
+		cfg = LN8000_VAC_OVP_6P5V;
+	} else if (ovp_th <= 11000000) {
+		cfg = LN8000_VAC_OVP_11V;
+	} else if (ovp_th <= 12000000) {
+		cfg = LN8000_VAC_OVP_12V;
+	} else {
+		cfg = LN8000_VAC_OVP_13V;
+	}
