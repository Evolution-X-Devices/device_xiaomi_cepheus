+	PR_REGISTER = BIT(1),
+	PR_OEM = BIT(2),
+	PR_DEBUG = BIT(3),
+};
+
+static int debug_mask = PR_OEM;
+module_param_named(debug_mask, debug_mask, int, 0600);
+
+#define INVALID_REG_ADDR 0xFF
+
