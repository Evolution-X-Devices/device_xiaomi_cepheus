+		status = "ok";
+		qcom,firmware-name = "slpi_vy";
+	};
+
+	thermal_message: thermal-message {
+		board-sensor = "quiet_therm";
+	};
+};
+
+&sdhc_2 {
+	cd-gpios = <&tlmm 96 GPIO_ACTIVE_HIGH>;
+	status = "ok";
+ };
+
+&tlmm {
+        /* GPIO_37 : FP_RESET_N */
+        msm_gpio_37: msm_gpio_37 {
+                mux {
+                         pins = "gpio37";
+                         function = "gpio";
+                };
+
+                config {
+                        pins = "gpio37";
+                        drive-strength = <2>;
+                        bias-disable;
+                        output-low;
+                };
+        };
+
+        /* GPIO_37 : FP_RESET_N, state device active*/
+        msm_gpio_37_output_high: msm_gpio_37_output_high {
+                mux {
+                        pins = "gpio37";
+                        function = "gpio";
+                };
+
+                config {
+                        pins = "gpio37";
+                        drive-strength = <2>;
+                        bias-disable;
+                        output-high;
+                };
+        };
+
+        /* GPIO_120 : FP_INT_N */
+        msm_gpio_120: msm_gpio_120 {
+                mux {
+                        pins = "gpio120";
+                        function = "gpio";
+                };
+
+                config {
+                        pins = "gpio120";
+                        drive-strength = <2>;
+                        bias-pull-down;
+                };
+        };
+};
