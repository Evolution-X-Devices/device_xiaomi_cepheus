+static void nvt_pen_charge_state_change_work(struct work_struct *work)
+{
+	NVT_LOG("pen charge is %s", ts->pen_is_charge ? "ENABLE" : "DISABLE");
+	disable_pen_input_device(ts->pen_is_charge);
+}
