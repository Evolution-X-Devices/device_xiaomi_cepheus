+	if (NVT_proc_aftersales_test_entry == NULL) {
+		NVT_ERR("create /proc/tp_selftest Failed!\n");
+		return -1;
+	} else {
+		NVT_LOG("create /proc/tp_selftest Succeeded!\n");
