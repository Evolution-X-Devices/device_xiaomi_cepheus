+	u16 *total_adjvert = NULL;
+
+	/* MS CX TEST */
+	logError(0, "%s\n", tag);
+
+	ret = readMutualSenseCompensationData(LOAD_CX_MS_LOW_POWER,
+					      &msCompData);
+	/* read MS compensation data */
+	if (ret < 0) {
+		logError(
