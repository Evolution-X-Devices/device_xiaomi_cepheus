+		{ "reg", 174 },	     { "rfloor", 8971 }, { "rho", 961 },
+		{ "rlm", 8207 },     { "rsaquo", 8250 }, { "rsquo", 8217 },
+		{ "sbquo", 8218 },   { "scaron", 353 },	 { "sdot", 8901 },
+		{ "sect", 167 },     { "shy", 173 },	 { "sigma", 963 },
