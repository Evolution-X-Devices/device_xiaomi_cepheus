+		if (ret == 1) {
+			if ((p_dev->diffdata_option & _DATA_LARGE_ENDIAN) ||
+			    (p_dev->diffdata_option & _DATA_DRV_SEN_INVERT)) {
+				reshape_data(p_dev->diffdata_option, p_dev,
+					     p_diffdata);
+			}
+		}
