+			logError(0, "%s MS CX1 TEST:.................OK \n\n",
+				 tag);
+	} else
+		logError(0, "%s MS CX1 TEST:.................SKIPPED \n\n",
+			 tag);
+
+	kfree(thresholds);
+	thresholds = NULL;
+
+	if (todo->MutualCx2 == 1) {
+		logError(1, "%s MS CX2 MIN MAX TEST: \n", tag);
