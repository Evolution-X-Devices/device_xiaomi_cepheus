+	/*init need check key*/
+	ret = alloc_mem_in_heap((void **)&p_need_check_key->p_data_buf,
+				data_len);
+	if (ret == 0) {
+		board_print_error("need check key buf malloc memory error!\n");
+		return 0;
+	}
+	p_need_check_key->len = 0;
+	memset(p_need_check_key->p_data_buf, 0, data_len);
