+		{ "phi", 966 },	     { "pi", 960 },	 { "piv", 982 },
+		{ "plusmn", 177 },   { "pound", 163 },	 { "prime", 8242 },
+		{ "prod", 8719 },    { "prop", 8733 },	 { "psi", 968 },
+		{ "quot", '\"' },    { "rArr", 8658 },	 { "radic", 8730 },
+		{ "rang", 9002 },    { "raquo", 187 },	 { "rarr", 8594 },
