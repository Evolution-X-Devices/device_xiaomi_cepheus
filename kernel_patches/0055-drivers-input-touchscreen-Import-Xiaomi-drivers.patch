+struct fts_hw_platform_data {
+	int (*power)(bool on);
+	int irq_gpio;
+	int reset_gpio;
+	unsigned long irq_flags;
+	unsigned int x_max;
+	unsigned int y_max;
+	const char *vdd_reg_name;
+	const char *avdd_reg_name;
+	const char *default_fw_name;
+	size_t config_array_size;
+	struct fts_config_info *config_array;
+	int current_index;
+#ifdef PHONE_KEY
+	size_t nbuttons;
+	int *key_code;
+#endif
