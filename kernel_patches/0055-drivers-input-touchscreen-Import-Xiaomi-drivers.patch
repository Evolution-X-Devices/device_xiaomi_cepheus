+*******************************************************************************/
+extern s32 print_rawdata_test_res(ptr32 p_data)
+{
+	s32 ret = 1;
+	u16 i = 0;
+	PST_TEST_ITEM p_test_item = NULL;
+	PST_RAWDATA_TEST_RES p_raw_test_res = NULL;
+	s32 open_test_res = 0;
