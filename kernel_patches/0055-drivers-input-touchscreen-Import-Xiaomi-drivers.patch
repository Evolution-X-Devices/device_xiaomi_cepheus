+static void goodix_cmds_init(struct goodix_ts_cmd *ts_cmd, u8 cmds, u8 cmd_data,
+			     u32 reg_addr)
+{
+	if (reg_addr) {
+		ts_cmd->cmd_reg = reg_addr;
+		ts_cmd->length = 3;
+		ts_cmd->cmds[0] = cmds;
+		ts_cmd->cmds[1] = cmd_data;
+		ts_cmd->cmds[2] = 0 - cmds - cmd_data;
+		ts_cmd->initialized = true;
+	} else {
+		ts_cmd->initialized = false;
+	}
+}
