diff --git a/drivers/input/touchscreen/xiaomi/nt36672c/nt36xxx_ext_proc.c b/drivers/input/touchscreen/xiaomi/nt36672c/nt36xxx_ext_proc.c
new file mode 100644
index 000000000..ece361273
--- /dev/null
+++ b/drivers/input/touchscreen/xiaomi/nt36672c/nt36xxx_ext_proc.c
@@ -0,0 +1,737 @@
+/*
+ * Copyright (C) 2010 - 2018 Novatek, Inc.
+ *
+ * $Revision: 32206 $
+ * $Date: 2018-08-10 19:23:04 +0800 (週五, 10 八月 2018) $
