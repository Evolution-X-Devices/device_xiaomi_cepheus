+		       x_ch * y_ch * sizeof(int32_t));
+		tbuf->opentest.len = x_ch * y_ch * sizeof(int32_t);
+		NVT_LOG("===========SRC:=============\n");
+		dump_buff(rawdata, x_ch, y_ch);
+		NVT_LOG("===========DST(%p):=============\n",
+			tbuf->opentest.buf);
+		dump_buff((int32_t *)tbuf->opentest.buf, x_ch, y_ch);
+		NVT_LOG("OPEN_TEST copy complete");
+		break;
+	case FWMUTUAL_TEST:
