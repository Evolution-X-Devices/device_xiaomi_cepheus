+static ssize_t fts_selftest_read(struct file *file, char __user *buf,
+				 size_t count, loff_t *pos)
+{
+	char tmp[5] = { 0 };
+	int cnt;
+
+	if (*pos != 0)
+		return 0;
+	cnt = snprintf(tmp, sizeof(fts_info->result_type), "%d\n",
+		       fts_info->result_type);
