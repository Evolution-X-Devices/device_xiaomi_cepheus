+*/
+struct gesture_module {
+	atomic_t registered;
+	unsigned int kobj_initialized;
+	rwlock_t rwlock;
+	unsigned char gesture_type[GSX_GESTURE_TYPE_LEN];
+	unsigned char gesture_data[GSX_KEY_DATA_LEN];
