+				/*----------------------tp open test-----------------------*/
+			case TP_RAWDATA_TEST_ITEMS_SET_ID: {
+				ret = release_rawdata_test_item((
+					p_test_proc_data->pp_test_item_arr)[i]);
+			} break;
+
+				/*----------------------hardware test-----------------------*/
