+
+/*!
+* \file ftsCore.h
+* \brief Contains all the definitions and structs of Core functionalities
+*/
+
+#ifndef FTS_CORE_H
+#define FTS_CORE_H
+
+#include "ftsHardware.h"
+#include "ftsSoftware.h"
