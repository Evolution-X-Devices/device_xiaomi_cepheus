+
+	if (ts->dev_pm_suspend) {
+		NVT_LOG("tp has dev_pm_suspend status\n");
+		return 0;
+	}
+
+	if (bTouchIsAwake)
+		ret = nvt_set_pocket_palm_switch(value);
+	return ret;
+}
