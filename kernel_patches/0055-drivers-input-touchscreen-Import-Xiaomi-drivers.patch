+/*******************************************************************************
+* Function Name	: init_for_buffer
+* Description	: initialize temp buffer with 0
+* Input			: u8* p_buf
+: u16 buf_size
+* Output		: u8* p_buf
+* Return		: s32(0:Fail 1:Ok)
+*******************************************************************************/
+static s32 init_for_buffer(u8 *p_buf, u16 buf_size)
+{
+	s32 ret = 1;
+	u16 i = 0;
+	for (i = 0; i < buf_size; i++) {
+		p_buf[i] = 0;
+	}
+	return ret;
+}
